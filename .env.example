SESSION_LIFETIME=120
QUEUE_CONNECTION=sync

###############################################################################
# FILE STORAGE CONFIGURATION
###############################################################################
FILESYSTEM_DISK=public

###############################################################################
# BROADCASTING CONFIGURATION (Development Mode)
# For real-time notifications, use one of these options:
# - log: Logs events to storage/logs/laravel.log (current - development)
# - pusher: Use Pusher service with real WebSocket
# - redis: Use Redis for local broadcasting
###############################################################################
# BROADCAST_DRIVER=log
BROADCAST_DRIVER=pusher

###############################################################################
# PUSHER CONFIGURATION (Optional - for production)
# Setup: https://pusher.com
# To enable: Change BROADCAST_DRIVER=pusher and add real credentials
###############################################################################
